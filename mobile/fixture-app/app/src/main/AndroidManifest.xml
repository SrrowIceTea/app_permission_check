<?xml version="1.0" encoding="utf-8"?>
<!--
  移动隐私演示夹具清单 —— 仅用于授权测试（自有设备与自有 APK）。

  这里是「权限必要性」检测线的静态信号源。其中：
    * READ_SMS 是**刻意的过度索权**：本 App 的业务功能是「展示附近演示点位」，
      没有任何短信相关功能。它的存在让 over_permission 规则有真实的命中对象。
    * QUERY_ALL_PACKAGES 是安装期权限（无运行时弹窗），用来验证
      「无运行时同意事件」这条路径——它既可能被误判成违规，也确实是监管高发项，
      报告需结合 API 性质判断（见 mobile/CLAUDE.md 的能力边界）。
  For authorized testing on owned devices and APKs only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 业务功能所需（政策里声明了） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 刻意的过度索权：与「展示附近演示点位」这一业务功能无关 -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- 应用列表可见性（安装期权限，无运行时弹窗） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- usesCleartextTraffic 刻意打开：明文 HTTP 外发是检测项之一，必须可复现 -->
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
