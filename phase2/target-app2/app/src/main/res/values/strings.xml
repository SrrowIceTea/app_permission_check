<?xml version="1.0" encoding="utf-8"?>
<!-- 仅用于授权测试（自有设备与自有 APK）。 -->
<resources>
    <string name="app_name">VScanner 靶子App</string>
    <!--
      10.0.2.2 = 模拟器宿主环回。默认指向 Phase 4 的 Mitmproxy（反向模式，监听 8888）。
      原默认值 8080/8443 是"直连一台假想的接收服务器"，但本设备上系统全局代理
      不会传播到 wifi 网络（实测 `dumpsys wifi` 恒为 `Proxy settings: NONE`），
      所以审计代理只能由被测应用直接寻址。见 phase4/DECISIONS.md D401。
    -->
    <string name="default_http_endpoint">http://10.0.2.2:8888/collect</string>
    <string name="default_https_endpoint">https://10.0.2.2:8888/collect</string>
</resources>
