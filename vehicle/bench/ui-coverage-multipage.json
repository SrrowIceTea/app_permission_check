  "window_seconds": 36,
  "fixtures": {
    "g1-multipage": {
      "package": "com.vscanner.targetapp.g1",
      "stack_package": "com.vscanner.targetapp",
      "entry_activity": "com.vscanner.targetapp.CoverageMenuActivity"
    }
  },
  "pages": [
    {"id": "menu", "activity": "com.vscanner.targetapp.CoverageMenuActivity"},
    {"id": "read", "activity": "com.vscanner.targetapp.CoverageReadActivity"},
    {"id": "subscription", "activity": "com.vscanner.targetapp.CoverageSubscriptionActivity"}
  ],
  "actions": [
    {"id": "open_read", "page": "menu", "control": "btnG1OpenRead", "destination": "read"},
