      "category": "media",
      "license_path": "LICENSE",
      "support_source": "https://github.com/Vito0912/yaabsa",
      "needs_backend": true
    },
    {
      "id": "mg4-webbrowser",
      "family": "mg4-webbrowser",
      "repo": "Tommasov/MG4_WebBrowser",
      "asset_pattern": "^com\\.tommasov\\.mg4browser-[0-9]+\\.apk$",
